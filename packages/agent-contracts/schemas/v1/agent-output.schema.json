{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "content_type": {
          "enum": [
            "application/json",
            "text/plain",
            "text/markdown",
            "application/x-tar"
          ],
          "title": "Content Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "maximum": 8388608,
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "uri": {
          "pattern": "^s3://[a-z0-9-]+/[a-zA-Z0-9_./-]+$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "content_type",
        "size",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "JsonValue": {},
    "OutputFile": {
      "additionalProperties": false,
      "properties": {
        "content_type": {
          "enum": [
            "application/json",
            "text/plain",
            "text/markdown",
            "application/x-tar"
          ],
          "title": "Content Type",
          "type": "string"
        },
        "max_bytes": {
          "maximum": 8388608,
          "minimum": 1,
          "title": "Max Bytes",
          "type": "integer"
        },
        "path": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "maximum": 8388608,
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "content_type",
        "max_bytes",
        "size",
        "sha256"
      ],
      "title": "OutputFile",
      "type": "object"
    }
  },
  "$id": "urn:local-airflow-poc:agent-output:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Also the script output contract; worker identity/digests are added by the runtime.",
  "properties": {
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "base_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Base Sha",
      "type": "string"
    },
    "dag_id": {
      "pattern": "^[a-zA-Z0-9_-]{1,80}$",
      "title": "Dag Id",
      "type": "string"
    },
    "dag_run_id": {
      "title": "Dag Run Id",
      "type": "string"
    },
    "ended_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "input_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Digest"
    },
    "output_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Digest"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/OutputFile"
      },
      "maxItems": 20,
      "title": "Outputs",
      "type": "array"
    },
    "patch": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "policy_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Version"
    },
    "review": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review"
    },
    "runtime_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runtime Version"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "summary": {
      "maxLength": 2000,
      "title": "Summary",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[a-zA-Z0-9_-]{1,80}$",
      "title": "Task Id",
      "type": "string"
    },
    "validation": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation"
    },
    "worker": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker"
    }
  },
  "required": [
    "dag_id",
    "dag_run_id",
    "task_id",
    "attempt",
    "base_sha",
    "outputs",
    "summary"
  ],
  "title": "AgentOutput",
  "type": "object"
}
